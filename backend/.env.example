# PostgreSQL. Use the direct connection (port 5432) for migrations.
# On Supabase, set DATABASE_URL to the pooler (transaction mode, port 6543)
# and DIRECT_URL to the direct connection. Locally both can be the same.
DATABASE_URL=postgresql://forma:forma@localhost:5432/forma?schema=public
DIRECT_URL=postgresql://forma:forma@localhost:5432/forma?schema=public

NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:3000

# Public storefront origin. Used in owner emails and Meta event source URLs.
STORE_URL=http://localhost:3000
STORE_NAME=Forma
SUPPORT_EMAIL=hello@forma.local

# At least 16 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-a-long-random-string
ADMIN_JWT_EXPIRES_IN=8h

# Use lax + COOKIE_SECURE=false on http://localhost.
# When the store and API are on different HTTPS sites, set COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Razorpay Dashboard → Settings → API Keys. Use Test Mode until go-live.
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks. Create a webhook for the raw URL
# https://<api-host>/api/payments/webhook and subscribe to payment.captured,
# payment.failed, and order.paid.
RAZORPAY_WEBHOOK_SECRET=

# Resend → API Keys. Verify a sender domain before production mail.
# https://resend.com/domains
# Until a domain is verified, Resend only delivers to the account email, often via onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# Supabase → Project Settings → API. Use the service role key on the server only.
# Create a public Storage bucket named product-images.
# https://supabase.com/dashboard/project/_/storage/buckets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Meta Events Manager → Pixel → Settings. CAPI token is a server secret.
# https://business.facebook.com/events_manager
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_TEST_EVENT_CODE=

# Shipping is calculated only on the server. Amounts are paise (79.00 INR = 7900).
SHIPPING_FEE_PAISE=7900
FREE_SHIPPING_THRESHOLD_PAISE=99900
RESERVATION_MINUTES=30

# Used by prisma/seed.js. Choose a password of at least 10 characters.
# The seed never overwrites an existing admin password.
SEED_ADMIN_EMAIL=admin@forma.local
SEED_ADMIN_PASSWORD=replace-with-at-least-10-characters
SEED_ADMIN_NAME=Store Admin
